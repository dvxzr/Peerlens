{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peerlens",
  "version": "0.2.7",
  "identifier": "dev.peerlens.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Peerlens",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#121219",
        "trafficLightPosition": {
          "x": 18,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Review GitLab merge requests with a local, read-only AI agent",
    "longDescription": "Peerlens lists your GitLab merge requests and reviews them with Claude Code or Codex running locally in read-only mode. It talks to GitLab only through glab with GET requests. Nothing is applied, committed or posted.",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBREE0QTMwNzI5NUNBN0YKUldSL3lwVnlNRXJhR2g5NFpSNFd1SFBFVkZCZE1VVmpKWFM4NmJ5K1I5N0Rzbkg4S0g0MWZOd3IK",
      "endpoints": [
        "https://github.com/dvxzr/Peerlens/releases/latest/download/latest.json"
      ]
    }
  }
}